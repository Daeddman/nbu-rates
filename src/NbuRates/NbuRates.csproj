<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NbuRates</RootNamespace>
    <AssemblyName>NbuRates</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite: ADO.NET-провайдер разом із нативною бібліотекою sqlite3 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <!-- Налаштування з appsettings.json та змінних середовища, а не з коду -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

</Project>
